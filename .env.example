# Google Drive API Configuration
# Get these credentials from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project or select existing one
# 2. Enable Google Drive API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized JavaScript origins: http://localhost:5173
# 5. Add authorized redirect URIs: http://localhost:5173
# 6. Copy Client ID and API Key below

VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Application Configuration
VITE_APP_ID=app-87ml1bn52jgh
VITE_API_ENV=production
